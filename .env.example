# PromptForge — configuration Docker (optionnelle)
#
# Ce fichier est OPTIONNEL : sans lui, les valeurs par defaut de `compose.yaml`
# suffisent. Pour t'en servir, copie-le en `.env` :
#
#     cp .env.example .env
#
# `.env` est ignore par git (voir .gitignore).
#
# AUCUN SECRET ICI. PromptForge est 100 % local : il n'a besoin d'aucune cle
# d'API, d'aucun jeton, d'aucun mot de passe. Si tu es en train d'en coller un
# dans ce fichier, c'est qu'il y a un malentendu.
#
# Les variables ci-dessous sont celles que `compose.yaml` lit depuis ce fichier.


# === MODELE OLLAMA ===
# Modele utilise par l'interface web. Il doit etre installe sur l'hote :
#   ollama pull <modele>   puis   ollama list
# Defaut applique par compose.yaml si non defini : qwen3:8b
#
# OLLAMA_MODEL=qwen3:8b


# === SCANNER : quel dossier de l'hote le conteneur peut lire ===
# Le conteneur ne voit que ce dossier, monte en LECTURE SEULE sur /hostfs.
# L'onglet Scanner ne peut analyser que ce qui s'y trouve.
#
# Defaut applique par compose.yaml si non defini : ../
# c'est-a-dire le dossier PARENT du depot. Si tu as clone PromptForge dans
# ~/Dev/PromptForge, alors /hostfs dans le conteneur = ~/Dev, donc tous les
# projets ranges a cote.
#
# Pour elargir ou deplacer :
#   Linux / macOS : HOSTFS_PATH=/home/tonuser
#   Windows       : HOSTFS_PATH=C:/Users/TonNom
#
# HOSTFS_PATH=../


# === DELAI D'ATTENTE OLLAMA ===
# Secondes accordees a une generation avant d'abandonner.
# Defaut applique par le code si non defini : 600
#
# Ce defaut vient d'une mesure, pas d'une intuition : sur un Mac M1 Max,
# qwen3:14b a mis jusqu'a 195 s pour un reformatage ordinaire, sans charge
# particuliere. Le premier appel apres le demarrage charge le modele en
# memoire et coute nettement plus cher que les suivants.
#
# Une valeur absente, non entiere, nulle ou negative retombe sur 600 avec un
# avertissement dans les journaux. Le service ne plante pas au demarrage.
#
# OLLAMA_TIMEOUT=600
