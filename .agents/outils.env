# .agents/outils.env — généré depuis la fiche §1.5 (outillage_qualite). Fichier protégé, seule source de
# configuration du socle. Convention : le contrôle NOM exécute NOM_CMD. Les outils viennent du venv du dépôt
# (.venv, cf. CONTRIBUTING.md) : "$RACINE" est développé à la lecture, d'où des chemins absolus que les hooks
# trouvent quel que soit le PATH du harness.
HARNESS="claude-code"
CRITICITE="prod"
BRANCHE_PRINCIPALE="main"
CODEOWNER="@budocay"
TEST_CMD="$RACINE/.venv/bin/python -m pytest tests/ -q -m 'not integration' -p no:cacheprovider"
TEST_SETUP_CMD=""
FORMAT_CHECK_CMD="$RACINE/.venv/bin/black --check --quiet"
FORMAT_EXT="py"
LINT_CMD="$RACINE/.venv/bin/ruff check --quiet"
LINT_EXT="py"
SECRETS_STDIN_CMD="gitleaks stdin --no-banner --no-color --redact -v"
SECRETS_PLAGE_CMD="gitleaks git --no-banner --no-color --redact -v --log-opts"
TESTS_GLOB="tests/test_*.py"
DEPS_AGE_MIN_JOURS=7
DEPS_APPROUVEES=""
CONTROLES_SUPPL="SAST SCA"
CONTROLES_SECURITE="SAST SCA"
# SAST : seuls les constats NOUVEAUX par rapport à la base de référence (7 constats existants, dette D-069).
SAST_CMD="$RACINE/.venv/bin/bandit -r promptforge -q -ll -b .bandit-baseline.json"
# SCA : vulnérabilités connues des paquets installés dans le venv (OSV/PyPI, réseau requis).
SCA_CMD="$RACINE/.venv/bin/pip-audit --skip-editable --progress-spinner off"
ACCEPTE_UNVERIFIED=""
ACCEPTE_UNVERIFIED_LOCAL=""
GATES_STANDARD="agent-architecte agent-securite agent-craft"
GATES_STRUCTUREL="agent-architecte agent-securite agent-craft"
GATE_CMD="claude -p"
GATE_CRITIQUE_CMD=""
GATE_CRITIQUE_AGENTS=""
PARTAGE_EXTERNE_AUTORISE="non"
