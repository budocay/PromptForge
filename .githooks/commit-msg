#!/bin/bash
# Chaque commit déclare son auteur (« Agent: <id> » ou « Agent: dev ») et, pour un agent, sa feature
# (« Feature: F-xxx » ou « Feature: trivial ») ; un agent ne commite que dans son
# périmètre. Le trailer est déclaratif : il protège des débordements accidentels, la revue CODEOWNERS et
# la CI protègent du reste (§2.3).
C="$(git rev-parse --show-toplevel)/.agents/checks"
# Merge : contrôlé au push et en CI sur ce que sa résolution ajoute à la fusion automatique (perimetre.sh).
[ -f "$(git rev-parse --git-path MERGE_HEAD)" ] && exit 0
agent="$(git interpret-trailers --parse "$1" | sed -n 's/^Agent: *//p' | head -n 1 | tr -d '[:space:]')"
[ -n "$agent" ] || { echo "FAIL : trailer 'Agent: <id>' manquant (ou 'Agent: dev' pour un commit humain)" >&2; exit 2; }
feature="$(git interpret-trailers --parse "$1" | sed -n 's/^Feature: *//p' | head -n 1 | tr -d '[:space:]')"
[ "$agent" = dev ] || [ -n "$feature" ] || { echo "FAIL : trailer 'Feature: F-xxx' (ou 'Feature: trivial') manquant" >&2; exit 2; }
fichiers=()
while IFS= read -r f; do [ -n "$f" ] && fichiers+=("$f"); done <<EOF
$(git diff --cached --name-only --no-renames)
EOF
[ ${#fichiers[@]} -gt 0 ] || exit 0
exec "$C/perimetre.sh" --fichiers "$agent" "${fichiers[@]}"
